# v7.0.23 (TD-181): trusted reverse proxies for the real client IP (login rate limiting, audit IP).
# Default when empty: "loopback, linklocal" (Nginx on the same host). Kubernetes ingress: "loopback, linklocal, uniquelocal".
# Direct exposure without a proxy: "false". The unsafe value "true" is rejected at startup.
TRUST_PROXY=
WOOCOMMERCE_SSL_CA_PATH=