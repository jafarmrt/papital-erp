ADMIN_INITIAL_PASSWORD=
ALLOWED_ORIGINS=
DATABASE_URL=
DB_CONN_TIMEOUT=
DB_IDLE_IN_TX_TIMEOUT=
DB_IDLE_TIMEOUT=
DB_POOL_MAX=
DB_STATEMENT_TIMEOUT=
# v9.0.428 (TD-616): 1 runs the in-memory demo database (user admin / admin, every record lost on restart) when
# DATABASE_URL is empty; refused in production. Leave it empty: without DATABASE_URL the server does not start.
ERP_DEMO_MODE=
# v7.0.139 (TD-189): key (at least 32 characters, separate from JWT_SECRET) that encrypts third-party passwords
# such as the personnel Nobitex password (AES-256-GCM). Keep a safe copy: if it is lost, stored passwords cannot be read.
ERP_SECRETS_KEY=
ERP_SETUP_TOKEN=
# v7.0.27 (TD-185): return the JWT in login/setup response bodies (preview iframes that block cookies only). Leave unset in production.
EXPOSE_TOKEN_IN_BODY=
# v9.0.145 (TD-597): extra origins (comma separated) allowed to frame the app in production; preview hosts only. Empty = the app itself only.
FRAME_ANCESTORS=
GEMINI_API_KEY=
JWT_SECRET=
LOG_DIR=
LOG_LEVEL=
METRICS_TOKEN=
POSTGRES_SSL_CA_PATH=
# v7.0.23 (TD-181): trusted reverse proxies for the real client IP (login rate limiting, audit IP).
# Default when empty: "loopback, linklocal" (Nginx on the same host). Kubernetes ingress: "loopback, linklocal, uniquelocal".
# Direct exposure without a proxy: "false". The unsafe value "true" is rejected at startup.
TRUST_PROXY=
WOOCOMMERCE_SSL_CA_PATH=
# v10.0.4 (O-02, TD-957): encrypted off-server copy of the daily backup (docs/OFFSITE_BACKUP.md). An rclone «crypt»
# remote such as papital-crypt: ; the .env (with ERP_SECRETS_KEY) travels inside it. Empty = no off-server copy.
BACKUP_RCLONE_REMOTE=
# Days the off-server copies are kept (default 30); backup kinds copied off the server (default daily).
OFFSITE_RETENTION_DAYS=
BACKUP_OFFSITE_KINDS=
# v10.0.6 (O-03, TD-1021): alerts of scripts/monitor.sh. A Bale bot (or ALERT_BOT_API=https://api.telegram.org) ...
ALERT_BOT_TOKEN=
ALERT_CHAT_ID=
ALERT_BOT_API=
# v10.0.15 (TD-1001): an optional second bot with the same rules (e.g. Telegram besides Bale); each is sent on its own.
ALERT_BOT2_TOKEN=
ALERT_BOT2_CHAT_ID=
ALERT_BOT2_API=
# ... and/or e-mail through SMTP, e.g. ALERT_SMTP_URL=smtps://smtp.gmail.com:465 with a Gmail app password.
ALERT_SMTP_URL=
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_EMAIL_TO=
# Thresholds (defaults 85 percent disk, 26 hours backup age, a reminder every 6 hours while a problem stands).
MONITOR_DISK_PERCENT=
MONITOR_BACKUP_MAX_AGE_HOURS=
MONITOR_REPEAT_HOURS=
