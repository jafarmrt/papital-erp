ADMIN_INITIAL_PASSWORD=
ALLOWED_ORIGINS=
DATABASE_URL=
DB_CONN_TIMEOUT=
DB_IDLE_IN_TX_TIMEOUT=
DB_IDLE_TIMEOUT=
DB_POOL_MAX=
DB_STATEMENT_TIMEOUT=
# v7.0.139 (TD-189): key (at least 32 characters, separate from JWT_SECRET) that encrypts third-party passwords
# such as the personnel Nobitex password (AES-256-GCM). Keep a safe copy: if it is lost, stored passwords cannot be read.
ERP_SECRETS_KEY=
ERP_SETUP_TOKEN=
# v7.0.27 (TD-185): return the JWT in login/setup response bodies (preview iframes that block cookies only). Leave unset in production.
EXPOSE_TOKEN_IN_BODY=
# v9.0.145 (TD-597): extra origins (comma separated) allowed to frame the app in production; preview hosts only. Empty = the app itself only.
FRAME_ANCESTORS=
GEMINI_API_KEY=
JWT_SECRET=
LOG_DIR=
LOG_LEVEL=
METRICS_TOKEN=
POSTGRES_SSL_CA_PATH=
# v7.0.23 (TD-181): trusted reverse proxies for the real client IP (login rate limiting, audit IP).
# Default when empty: "loopback, linklocal" (Nginx on the same host). Kubernetes ingress: "loopback, linklocal, uniquelocal".
# Direct exposure without a proxy: "false". The unsafe value "true" is rejected at startup.
TRUST_PROXY=
WOOCOMMERCE_SSL_CA_PATH=