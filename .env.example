# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Authentication Secret Key (must be at least 32 characters)
# Generate with: openssl rand -hex 48
JWT_SECRET=c8f49a1b3e7d20569a0e4b81c3d5f7a29e4b6c8d0f1a3e5b7c9d1e3f5a7b9c1d

# Comma-separated list of allowed CORS origins
# Example: https://erp.example.com,https://admin.erp.example.com
ALLOWED_ORIGINS=http://localhost:3000

# Application Logging Configuration
LOG_LEVEL=info
LOG_DIR=logs

# Postgres Database Configuration
DATABASE_URL=postgresql://user:password@host:5432/dbname
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_CONN_TIMEOUT=5000
DB_STATEMENT_TIMEOUT=60000
DB_IDLE_IN_TX_TIMEOUT=30000
POSTGRES_SSL_CA_PATH=

# WooCommerce Integration TLS Configuration
WOOCOMMERCE_SSL_CA_PATH=

# Initial Setup Security Token (Required to execute /api/setup)
# Generate with: openssl rand -hex 24
ERP_SETUP_TOKEN=e4b7a19c2f8d3e5a7b0c2d4e6f8a1b3c5d7e9f0a2b4c6d8e

# Seed Production Safety Gating
ALLOW_SEED_IN_PRODUCTION=false

# ─── Test & Cleanup Flags ────────────────────────────────────────────────
# ENABLE_TEST_ENDPOINTS: Controls /api/system/tests/run and
# /api/system/clean-test-data (non-production only; hard-blocked when
# NODE_ENV=production). Effective value precedence:
#   1) appSettings key `runtime_enable_test_endpoints` (managed from the
#      in-app «پیکربندی سیستمی» tab by an admin — applied live, no restart)
#   2) this env variable (fallback when no DB value exists)
#   3) false (safe default)
# WARNING: running tests from inside the app writes real documents/users/
# vouchers to the LIVE database and consumes document numbering sequences.
# The safe way to run tests is `npm run test` from the CLI, which enables
# fixture cleanup automatically.
ENABLE_TEST_ENDPOINTS=false

# ERP_ALLOW_TEST_CLEANUP: Master switch for test-fixture cleanup
# (cleanupAllTestFixtures). Deliberately file-only and NEVER settable from
# the UI — it deletes data (scoped to synthetic test identifiers).
# `npm run test` (scripts/run-tests.ts) sets it to 1 automatically; any
# manual invocation must opt in explicitly.
# ERP_ALLOW_TEST_CLEANUP=0