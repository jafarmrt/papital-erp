# Papital storefront (papitalgallery.com): the service's settings, phase 8.6.
# storefront.sh copies this file to /etc/papital-storefront/storefront.env (root only, mode 600) on the first install
# and never overwrites it afterwards. systemd reads it before the service starts (EnvironmentFile), so the service
# itself cannot read or change it. NEVER put a filled copy of this file in git: the repository is public.

# The ERP's Storefront API. On the ERP server itself the site talks to the ERP over the loopback, never through the
# internet. On another server (for example a server in Iran) it is the ERP's public https address:
#   STOREFRONT_API_URL=https://erp.example.com/api/storefront/v1
STOREFRONT_API_URL=http://127.0.0.1:3000/api/storefront/v1

# The key made in the ERP: «فروشگاه سایت» → «کلید برنامه سایت». It is shown once. Leave it empty here in the template.
STOREFRONT_API_KEY=

# The public address of the site, https and without a trailing slash. Its host is the only origin the site's forms
# are accepted from (React Router 7.18 refuses a post whose Origin is another host), so it must be exactly the
# address visitors use. On a test address, put that test address here.
STOREFRONT_SITE_URL=https://papitalgallery.com

# 1 = read the visitor's address from X-Real-IP, which the nginx site of storefront-nginx.sh always rewrites.
# Set it to 1 only behind that nginx site (or another web server that rewrites X-Real-IP itself).
STOREFRONT_TRUST_PROXY=1

# Where the service listens. Keep it on the loopback: nginx is the only door from the internet.
STOREFRONT_HOST=127.0.0.1
STOREFRONT_PORT=3100

# 1 = no page may be indexed by search engines. Use 1 on a test address, and set it back to 0 on the real domain.
STOREFRONT_NOINDEX=1

# A strip on top of every page, only for a preview. Leave it empty on the real site.
STOREFRONT_PREVIEW_NOTICE=

# 1 = the site can be installed on a phone (manifest and service worker). Off by default.
STOREFRONT_PWA=0

NODE_ENV=production
