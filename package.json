{
  "name": "workshop-erp-crm",
  "private": true,
  "version": "10.0.22",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs --external:./src/tests/* && node -e \"require('fs').cpSync('drizzle','dist/drizzle',{recursive:true})\" && node scripts/write-build-info.mjs",
    "start": "node dist/server.cjs",
    "test": "tsx scripts/run-tests.ts",
    "test:unit": "tsx scripts/run-tests.ts --layer=unit",
    "test:db": "tsx scripts/run-tests.ts --layer=database",
    "test:sec": "tsx scripts/run-tests.ts --layer=security",
    "test:api": "tsx scripts/run-tests.ts --layer=api",
    "test:reg": "tsx scripts/run-tests.ts --layer=regression",
    "test:vitest": "vitest run",
    "test:e2e": "playwright test",
    "simulate:year": "tsx scripts/simulate-business-year.ts",
    "attachments:migrate": "tsx scripts/migrate-attachments.ts",
    "attachments:cleanup": "tsx scripts/cleanup-attachments.ts",
    "dates:report": "tsx scripts/date-calendar-report.ts",
    "secrets:encrypt": "tsx scripts/encrypt-personnel-secrets.ts",
    "users:lock-plain-passwords": "tsx scripts/lock-plain-passwords.ts",
    "db:cleanup-test": "tsx scripts/cleanup-test-data.ts",
    "lint": "tsc --noEmit",
    "db:studio": "drizzle-kit studio",
    "check:version": "tsx scripts/check-version-sync.ts",
    "routes:permissions": "tsx scripts/route-permissions.ts",
    "release": "tsx scripts/release.ts",
    "release:renumber": "tsx scripts/release-renumber.ts",
    "audit:gate": "npm audit --json | tsx scripts/audit-gate.ts",
    "test:coverage": "c8 --reporter=text --reporter=text-summary --reporter=json-summary --include=src --include=server.ts --exclude=src/tests/** tsx scripts/run-tests.ts",
    "lint:eslint": "tsx scripts/eslint-ratchet.ts",
    "check:runtime-deps": "tsx scripts/check-runtime-deps.ts",
    "ratchet:permissions": "tsx scripts/permission-ratchet.ts",
    "ratchet:terminal-english": "tsx scripts/terminal-english-ratchet.ts"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "pg": "^8.22.0",
    "prom-client": "^15.1.3",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.101.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "c8": "^12.0.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hot-toast": "^2.6.0",
    "react-multi-date-picker": "^4.5.2",
    "react-router-dom": "^7.18.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "^5.0.3",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  }
}
